{
  "name": "@eupadev/core",
  "version": "0.2.0",
  "description": "Common core of the tools generated by EupaDev: HTTP server derived from the OpenAPI contract, PostgreSQL database, sessions, audit",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "eupadev-core": "bin/start.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./kit": "./kit/index.js",
    "./kit/*": "./kit/*"
  },
  "files": [
    "bin",
    "src",
    "migrations",
    "sql",
    "web",
    "kit"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "node --test tests/contract.test.js tests/http.test.js tests/advisory-replay.test.js tests/auth-unit.test.js tests/protections.test.js tests/front-unit.test.js tests/kit-unit.test.js",
    "test:db": "node --test tests/db.test.js tests/sessions.test.js tests/rate-limit.test.js",
    "test:keycloak": "node --test tests/keycloak.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:front": "node --test tests/front.test.js",
    "test:kit": "node --test tests/kit.test.js",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:front && pnpm test:db && pnpm test:keycloak && pnpm test:auth && pnpm test:kit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dompurify": "3.4.17",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "node-pg-migrate": "9.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/trusted-types": "2.0.7",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
