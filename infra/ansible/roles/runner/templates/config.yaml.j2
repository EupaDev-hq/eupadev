# Generated by Ansible — do not edit by hand.
# Runner "{{ runner_instance.name }}": {{ runner_instance.description }}
log:
  level: info

runner:
  file: /data/.runner
  # One job at a time per runner (small VM); to raise after measuring.
  capacity: 1
  timeout: 1h
  # Label targeted by `runs-on` in the pipelines, and default image of the
  # job (pinned version).
  labels:
    - "{{ runner_instance.label }}"

# ponytail: actions cache disabled (it needs a cache server reachable from
# the jobs); to enable if the pipelines become slow.
cache:
  enabled: false

container:
  # Network created automatically per job.
  network: ""
{% if runner_instance.docker %}
  # The VM's Docker mounted in the jobs: they build, scan and run images.
  # The agents' code is never run there directly.
  docker_host: ""
{% else %}
  # "-": the runner uses the VM's Docker to create the job, but does NOT
  # mount it in the job (neither socket nor DOCKER_HOST): the agents' code
  # run here cannot drive Docker.
  docker_host: "-"
{% endif %}
  privileged: false
  # Pull the job image again for each job (reason: runner_instances).
  force_pull: {{ runner_instance.force_pull | lower }}
  # Address of the forge in each job (no lab DNS assumed in a container);
  # with caddy_tls internal, the VM's trusted authorities (the forge's
  # included) too; Node has its own list, hence the variable.
  options: >-
    --add-host={{ gitea_domain }}:{{ forge_ip }}
{% if caddy_tls == 'internal' %}
    -v /etc/ssl/certs:/etc/ssl/certs:ro
    -e NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
  # Only volumes allowed in a job: never the Docker socket.
  valid_volumes:
    - /etc/ssl/certs
{% else %}
  valid_volumes: []
{% endif %}
