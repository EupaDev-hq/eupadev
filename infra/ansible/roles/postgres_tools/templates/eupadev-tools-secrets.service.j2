# Managed by Ansible (role postgres_tools) — do not edit on the VM.
# Secrets of the core tools decrypted in memory at each boot (nightly reboot
# included), before Docker restarts the tool containers that mount them.
[Unit]
Description=EupaDev: secrets of the core tools decrypted in memory
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Kept on restart (re-run after a registration): running tools keep their files.
RuntimeDirectory=eupadev/tools
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
ExecStart=/usr/local/sbin/eupadev-tools-secrets

[Install]
WantedBy=docker.service
