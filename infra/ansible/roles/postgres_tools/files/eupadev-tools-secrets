#!/bin/sh
# Managed by Ansible (role postgres_tools) — do not edit on the VM.
# Decrypts the secrets of the core tools (systemd-creds, written by the Gate 1
# registration playbook) into /run/eupadev/tools (tmpfs), readable by
# the tools' uid only: mounted as Compose secret files by eupadev-deployer.
# Run at boot before Docker, and again after each registration.
set -eu
dir=/run/eupadev/tools
rm -f "$dir"/tool-*
for c in /etc/eupadev/credstore.encrypted/tool-*; do
  [ -e "$c" ] || continue
  n=${c##*/}
  systemd-creds decrypt --newline=no --name="$n" "$c" "$dir/$n"
  chown 1000:1000 "$dir/$n"
  chmod 0400 "$dir/$n"
done
