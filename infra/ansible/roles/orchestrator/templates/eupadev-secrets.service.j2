# Managed by Ansible (orchestrator role) — do not edit by hand.
# Decrypts the orchestrator's secrets in memory, at each boot of the VM
# (nightly restart included), before Docker starts the containers again.
[Unit]
Description=EupaDev: orchestrator secrets decrypted in memory
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# /run/eupadev/secrets: tmpfs, 0700 root; deleted when the service stops.
RuntimeDirectory=eupadev/secrets
RuntimeDirectoryMode=0700
UMask=0077
{% for s in orchestrator_secrets %}
ExecStart=/usr/bin/systemd-creds decrypt --newline=no --name={{ s.name }} /etc/eupadev/credstore.encrypted/{{ s.name }} /run/eupadev/secrets/{{ s.name }}
ExecStart=/usr/bin/chown {{ s.uid }}:{{ s.uid }} /run/eupadev/secrets/{{ s.name }}
ExecStart=/usr/bin/chmod 0400 /run/eupadev/secrets/{{ s.name }}
{% endfor %}

[Install]
WantedBy=docker.service
