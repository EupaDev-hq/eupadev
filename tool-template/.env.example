# Copy to .env (never committed, see .gitignore) and fill in with real
# values. NEVER put a real value here — this file only documents the
# variables expected by a generated tool.

# Database — unprefixed name only, never a custom alias
# (PROD_*/PREVIEW_*), see .claude/rules/backend.md.
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Deployed tool's domain — never built from a request's Host header
# (links sent by email, CSRF verification), see
# .claude/rules/backend.md § Origin anchored on APP_URL.
APP_URL=http://localhost:3000

# HTTP port the tool listens on (default 3000).
PORT=3000
# Test-only authentication bypass. Must stay empty in production: the app refuses to start if it is set with NODE_ENV=production.
