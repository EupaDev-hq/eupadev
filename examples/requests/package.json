  "dependencies": {
    "@eupadev/core": "file:../../core"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "playwright-bdd": "9.2.1"
  }
