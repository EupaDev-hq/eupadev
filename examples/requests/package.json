{
  "name": "requests",
  "version": "0.1.0",
  "private": true,
  "description": "Example tool \"maintenance requests\" on @eupadev/core (step 8 of the core)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node node_modules/@eupadev/core/bin/start.js --verify",
