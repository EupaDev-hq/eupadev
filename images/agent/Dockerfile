# Image of the AI agents (Claude Code engine) — ROADMAP §8.11 no. 21, §8.16 L1-L2,
# ADR-013. Built by the CI of the CUSTOMER's forge, never published by
# EupaDev: Claude Code is not free software (Anthropic's commercial
# terms, §8.11 "Licences"); the installation downloads it, and this
# repository holds only the recipe.
#
# Base: `build` variant of the golden image (Node 24, pnpm, up-to-date
# Debian), passed by the CI from the organisation variable BASE_IMAGE_BUILD,
# resolved to a digest before the build. No default value: without the
# golden image, the build must fail.
#
# Left out on purpose: Docker client, sudo, curl, gpg, and every setuid/setgid
# bit (no privilege escalation tool). Non-root user `agent` (10001).

ARG BASE_IMAGE_BUILD

# --- Verified download of Claude Code (throwaway stage) ---
# Anthropic's official method ("Binary integrity and code signing",
# https://code.claude.com/docs/en/setup): each version publishes a
# manifest.json (sha256 of each binary) signed by Claude Code's GPG release
# key. Checked: 1) the key fingerprint, pinned below; 2) the manifest's
# signature by THIS key (VALIDSIG); 3) the manifest's version; 4) the binary's
# sha256 against the manifest. curl and gpg stay in this stage, not in the
# final image.
# Version bump: change CLAUDE_CODE_VERSION (reviewed PR, Renovate proposes
# it) — never automatic, never a "latest"/"stable" channel.
FROM ${BASE_IMAGE_BUILD} AS claude
ARG CLAUDE_CODE_VERSION=2.1.287
# Fingerprint of the key "Anthropic Claude Code Release Signing
# <security@anthropic.com>", published in the documentation above.
ARG CLAUDE_CODE_FINGERPRINT=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
# ponytail: linux-x64 binary only (lab and customer VMs are x86_64);
# an ARM VM will need the platform chosen from TARGETARCH.
ARG CLAUDE_CODE_PLATFORM=linux-x64
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /check
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN RELEASE_URL="https://downloads.claude.ai/claude-code-releases/$CLAUDE_CODE_VERSION"; \
    export GNUPGHOME=/check/gnupg; mkdir -m 0700 "$GNUPGHOME"; \
    curl -fsSL https://downloads.claude.ai/keys/claude-code.asc | gpg --batch --quiet --import; \
    curl -fsSLO "$RELEASE_URL/manifest.json"; \
    curl -fsSLO "$RELEASE_URL/manifest.json.sig"; \
    gpg --batch --status-fd 1 --verify manifest.json.sig manifest.json 2>/dev/null \
      | grep -q "^\[GNUPG:\] VALIDSIG .* $CLAUDE_CODE_FINGERPRINT\$" \
      || { echo "FAILED: manifest not signed by the key $CLAUDE_CODE_FINGERPRINT"; exit 1; }; \
    test "$(node -p 'require("./manifest.json").version')" = "$CLAUDE_CODE_VERSION"; \
    CHECKSUM="$(node -p "require('./manifest.json').platforms['$CLAUDE_CODE_PLATFORM'].checksum")"; \
    # 244 MB: without --speed-limit, a stalled download never ends
    # (job stuck, seen on 2026-10-14); < 10 KiB/s for 2 min → retry.
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 30 --speed-limit 10240 --speed-time 120 \
      -o claude "$RELEASE_URL/$CLAUDE_CODE_PLATFORM/claude"; \
    echo "$CHECKSUM  claude" | sha256sum -c -; \
    chmod 0755 claude; \
    test "$(./claude --version)" = "$CLAUDE_CODE_VERSION (Claude Code)"

# --- Final image ---
FROM ${BASE_IMAGE_BUILD} AS agent
# git: the agent clones its task's bundle and commits locally (it never
# pushes, the launcher does). Up-to-date Debian packages (base rebuilt
# every week), versions followed by the rebuild.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=claude /check/claude /usr/local/bin/claude
# Managed settings of Claude Code (settings documentation:
# /etc/claude-code/managed-settings.json, the strongest level, which neither
# the user nor the project overrides): GENERATED by
# orchestrator/scripts/generate-claude-check.ts from the same list of
# forbidden paths as the launcher. root, 0644;
# the container's root is read-only: the agent cannot touch it. An unreadable
# file makes Claude Code refuse to start (fail-closed, proved by
# check/claude.sh).
COPY managed-settings.json /etc/claude-code/managed-settings.json
RUN chown root:root /etc/claude-code/managed-settings.json && chmod 0644 /etc/claude-code/managed-settings.json
# User of the agents (the launcher runs --user 10001:10001 and mounts
# --tmpfs /home/agent). Then no setuid/setgid bit left in the image:
# su, passwd, chsh… can no longer give root.
RUN useradd --uid 10001 --user-group --create-home --home-dir /home/agent --shell /bin/bash agent \
    && find / -xdev -type f -perm /6000 -exec chmod ug-s {} +
# Claude Code settings through the environment (official documentation,
# env-vars): pinned version (no automatic update, no `claude update`), no
# traffic outside the API (telemetry and error reports off: fewer domains to
# allow). Never CLAUDE_CODE_EFFORT_LEVEL: it would override --effort.
# No CLAUDE_CODE_SUBPROCESS_ENV_SCRUB: it needs bubblewrap, which does not
# start under gVisor (trial of 2026-10-15), and the container carries no real
# credential (key added by the AI proxy, Git token at the launcher); this is
# Anthropic's reference (agent-sdk/secure-deployment: gVisor + proxy).
ENV DISABLE_AUTOUPDATER=1 \
    DISABLE_UPDATES=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
WORKDIR /home/agent
USER 10001:10001
