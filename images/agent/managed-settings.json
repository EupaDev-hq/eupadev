{
  "allowManagedHooksOnly": true,
  "disableAllHooks": true,
  "allowManagedPermissionRulesOnly": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(//tmp/task/**)"
    ],
    "deny": [
      "Edit(.claude/**)",
      "Edit(**/.claude/**)",
      "Edit(.gitea/**)",
      "Edit(**/.gitea/**)",
      "Edit(.github/**)",
      "Edit(**/.github/**)",
      "Edit(agents/**)",
      "Edit(**/agents/**)",
      "Edit(.opengrep/**)",
      "Edit(**/.opengrep/**)",
      "Edit(.git/**)",
      "Edit(**/.git/**)",
      "Edit(.husky/**)",
      "Edit(**/.husky/**)",
      "Edit(.vscode/**)",
      "Edit(**/.vscode/**)",
      "Edit(.idea/**)",
      "Edit(**/.idea/**)",
      "Edit(.devcontainer/**)",
      "Edit(**/.devcontainer/**)",
      "Edit(vendor/**)",
      "Edit(**/vendor/**)",
      "Edit(node_modules/**)",
      "Edit(**/node_modules/**)",
      "Edit(AGENTS.md)",
      "Edit(**/AGENTS.md)",
      "Edit(AGENTS.fr.md)",
      "Edit(**/AGENTS.fr.md)",
      "Edit(CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(CLAUDE.local.md)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(.mcp.json)",
      "Edit(**/.mcp.json)",
      "Edit(.npmrc)",
      "Edit(**/.npmrc)",
      "Edit(.pnpmfile.cjs)",
      "Edit(**/.pnpmfile.cjs)",
      "Edit(.pnpmfile.mjs)",
      "Edit(**/.pnpmfile.mjs)",
      "Edit(pnpm-workspace.yaml)",
      "Edit(**/pnpm-workspace.yaml)",
      "Edit(.gitmodules)",
      "Edit(**/.gitmodules)",
      "Edit(.gitattributes)",
      "Edit(**/.gitattributes)",
      "Edit(.devcontainer.json)",
      "Edit(**/.devcontainer.json)",
      "Edit(.gitleaksignore)",
      "Edit(**/.gitleaksignore)",
      "Edit(.semgrepignore)",
      "Edit(**/.semgrepignore)",
      "Edit(.trivyignore.yaml)",
      "Edit(**/.trivyignore.yaml)",
      "Edit(Dockerfile)",
      "Edit(**/Dockerfile)",
      "Edit(.dockerignore)",
      "Edit(**/.dockerignore)",
      "Edit(//home/agent/.claude/**)",
      "Edit(//etc/**)",
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  },
  "enableAllProjectMcpServers": false,
  "env": {
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_UPDATES": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
